---
import Base from "../layouts/Base.astro";
import AgentTrace from "../components/AgentTrace.astro";
import Guardrails from "../components/Guardrails.astro";

const description =
  "Senior software engineer in Las Vegas. 13+ years building LLM agents, MCP servers, and coding-agent tooling on C#/.NET and TypeScript.";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Andrew Oakeson",
  jobTitle: "Senior Software Engineer",
  email: "mailto:andrew@andrewoakeson.com",
  url: "https://andrewoakeson.com/",
  sameAs: [
    "https://www.linkedin.com/in/andrew-oakeson/",
    "https://github.com/aoakeson",
  ],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Weber State University",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Las Vegas",
    addressRegion: "NV",
    addressCountry: "US",
  },
  knowsAbout: [
    "LLM agents",
    "tool calling",
    "Model Context Protocol",
    "Claude Code",
    "OpenAI API",
    "C#",
    ".NET",
    "TypeScript",
    "FHIR",
    "SAML",
    "OIDC",
  ],
};
---

<Base
  title="Andrew Oakeson, Senior Software Engineer"
  description={description}
  canonical="https://andrewoakeson.com/"
  social
  jsonLd={JSON.stringify(person)}
>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <h1>Andrew Oakeson</h1>
    <p class="where">Las Vegas, Nevada</p>
    <p class="title">
      Senior software engineer. I build LLM agents and the tooling that keeps them in bounds.
    </p>
    <p class="lede">
      13+ years in C#/.NET and TypeScript. Recent work is tool-calling assistants,
      an MCP server, and coding-agent plugins, on top of production authentication
      and healthcare integrations.
    </p>
    <div class="actions">
      <a class="btn" href="/andrew-oakeson-resume.pdf" download>Resume</a>
      <a class="btn" href="https://www.linkedin.com/in/andrew-oakeson/">LinkedIn</a>
      <a class="btn btn-fill" href="mailto:andrew@andrewoakeson.com">Email</a>
    </div>
    <nav class="nav" aria-label="Sections">
      <a href="#skills">Technical skills</a>
      <a href="#work">What I work on</a>
      <a href="#selected">Selected work</a>
      <a href="#ai-workflow">How I build with AI</a>
      <a href="#experience">Experience</a>
      <a href="#approach">How I work</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>
  <main id="main" class="wrap" tabindex="-1">
    <section class="section" id="skills">
      <h2>Technical skills</h2>
      <dl class="skills">
        <div class="skill">
          <dt>AI applications</dt>
          <dd>
            OpenAI Chat Completions and Responses APIs, Gemini API, Vercel AI SDK,
            tool calling, structured outputs, strict JSON Schema and Zod, few-shot
            grounding, multimodal image editing.
          </dd>
        </div>
        <div class="skill">
          <dt>Agent context</dt>
          <dd>
            Open Knowledge Format, AGENTS.md and CLAUDE.md, task routers,
            path-scoped rules, knowledge graphs, CI knowledge validation,
            documentation provenance.
          </dd>
        </div>
        <div class="skill">
          <dt>AI-assisted delivery</dt>
          <dd>
            Claude Code, Codex, Cursor, MCP servers, plugins, hooks, and skills,
            multi-agent orchestration, worktrees, cross-model review, adversarial
            testing.
          </dd>
        </div>
        <div class="skill">
          <dt>Backend and data</dt>
          <dd>
            C#, ASP.NET Core, TypeScript, Python, Node.js, SQL Server, PostgreSQL
            and Supabase, Entity Framework Core, REST, GraphQL, Kafka.
          </dd>
        </div>
        <div class="skill">
          <dt>Frontend and cloud</dt>
          <dd>
            React, Angular, Next.js, Astro, Azure, AWS, Cloudflare Workers, Docker.
          </dd>
        </div>
        <div class="skill">
          <dt>Security and testing</dt>
          <dd>
            OAuth 2.0 and OIDC, PKCE, SAML, Azure AD B2C, Auth0, Key Vault, FHIR
            and SMART on FHIR, xUnit, Vitest, GitHub Actions.
          </dd>
        </div>
      </dl>
    </section>
    <section class="section" id="work">
      <h2>What I work on</h2>
      <article class="work-row">
        <h3>AI agents and LLM integration</h3>
        <div class="work-copy">
          <p>
            Tool-calling assistants, MCP servers, and coding-agent plugins.
            Typed tools, bounded loops, streamed tool steps, and role limits.
            Day-to-day delivery with Claude Code, Cursor, and Codex, including
            cross-model review.
          </p>
        </div>
      </article>
      <article class="work-row">
        <h3>Healthcare data and integrations</h3>
        <div class="work-copy">
          <p>
            Tenant-aware SMART on FHIR authorization on a .NET and Aidbox FHIR R4
            platform: scope and role constraints, token exchange, launch contexts,
            introspection, and membership. Provider and administration apps in
            React, TypeScript, TanStack, and Tailwind CSS with SMART/PKCE sign-in.
          </p>
        </div>
      </article>
      <article class="work-row">
        <h3>Identity and security</h3>
        <div class="work-copy">
          <p>
            SAML and OIDC/PKCE single sign-on, just-in-time provisioning, tenant
            access control, Auth0, Azure AD B2C, and Azure Key Vault. Includes an
            Okta to Azure AD B2C handoff for a state social-services integration.
          </p>
        </div>
      </article>
      <article class="work-row">
        <h3>Distributed backend</h3>
        <div class="work-copy">
          <p>
            .NET APIs and Kotlin/Kafka services for event-driven fulfillment and
            third-party data delivery, plus an import service with production
            monitoring on AWS and Docker.
          </p>
        </div>
      </article>
    </section>
    <section class="section" id="selected">
      <h2>Selected work</h2>
      <article class="case">
        <h3>Coding-agent plugins and context</h3>
        <p>
          Coding agents working in a healthcare codebase needed a required reading
          list and a way to catch unsafe changes. I authored okf-live and okf-lens,
          two TypeScript Claude Code plugins that track agent and subagent document
          reads, expose an MCP task-route tool, and check for secrets, protected
          health information in logs, and architecture violations. I tested bypass
          attempts in headless and interactive sessions.
        </p>
        <p>
          The context they route is Open Knowledge Format for the platform: 100+
          concepts, about 30 architecture decision records, task routing, shared
          AGENTS.md and CLAUDE.md instructions, path-scoped rules, and CI checks
          on metadata and links. AI-authored documents stay in a human-verification
          state until someone checks them.
        </p>
      </article>
      <article class="case">
        <h3>A bounded questionnaire assistant</h3>
        <p>
          Authors needed help inside the product without unrestricted writes. I
          built a GPT-4o prototype in .NET and Angular: a custom Chat Completions
          client, about 20 domain tools, a six-round cap, and Angular streaming
          over server-sent events. Update and delete tools stay off the list.
          The tools cover rule simulation, publish-readiness checks, and
          role-restricted publishing. This is a working prototype, not a shipped
          product feature.
        </p>
        <AgentTrace />
        <Guardrails />
      </article>
      <article class="case">
        <h3>Single sign-on for a healthcare partner</h3>
        <p>
          A healthcare partner needed IdP-initiated sign-on into a multi-tenant
          product, including provisioning. I built SAML single sign-on with tenant
          mapping and Microsoft Graph provisioning, and moved the signing keys into
          Azure Key Vault. It has been in production since early 2024.
        </p>
      </article>
      <article class="case">
        <h3>An always-on operations agent</h3>
        <p>
          I designed and operate a Claude Code agent, with MCP and Python, used
          daily by business partners and two outside clients for email and
          guest-message drafting, pricing briefs, research, and web development.
          Resources are isolated across 20+ Discord channels. Outbound messages
          require human approval, and each channel's sender address is locked in
          code and checked with Google OAuth.
        </p>
        <p>
          A separate scheduled agent researches, writes, and self-scores sourced
          articles, then delegates translation into five languages to parallel
          subagents. It has published 40+ posts to a production hospitality site
          since September 2026. The validator scores the draft. It is not a hard
          gate on publishing.
        </p>
      </article>
    </section>
    <section class="section" id="ai-workflow">
      <h2>How I build with AI</h2>
      <p>
        I use Claude Code, Cursor, and Codex for architecture, implementation,
        debugging, and cross-model review. The controls sit in the repository.
      </p>
      <ul class="approach">
        <li>
          One instruction source. AGENTS.md holds the shared rules, and CLAUDE.md
          imports them, so each coding agent starts from the same guidance.
        </li>
        <li>
          Task routers and path-scoped rules point an agent at the API contract,
          tenant rules, or protected-data notes for the files it is about to edit.
        </li>
        <li>
          Plugins record whether an agent actually read those documents, and pattern
          checks flag secrets, PHI in logs, and architecture violations. I ran
          adversarial sessions against skipped reading and prohibited patterns.
        </li>
        <li>
          For a legacy documentation pass, I directed about 40 agents with
          read-only source access and separate output ownership. That produced
          about 680 concepts and 2,400 relationships. The counts are the size of
          the knowledge bundle, not a productivity score.
        </li>
      </ul>
    </section>
    <section class="section" id="experience">
      <h2>Experience</h2>
      <ol class="timeline">
        <li class="job">
          <p class="when">Nov 2023 to Oct 2026</p>
          <div class="job-body">
            <h3>Senior Software Engineer, Opeeka</h3>
            <p>
              Coding-agent context and plugins, a bounded GPT-4o assistant prototype,
              production SAML, and SMART on FHIR APIs.
            </p>
          </div>
        </li>
        <li class="job">
          <p class="when">Apr 2023 to Oct 2023</p>
          <div class="job-body">
            <h3>Senior Software Engineer - Lead, BENlabs</h3>
            <p>
              Browser extensions across Angular, React, and Vue, with .NET services
              and JWT authentication for AI integrations.
            </p>
          </div>
        </li>
        <li class="job">
          <p class="when">Sep 2020 to Dec 2022</p>
          <div class="job-body">
            <h3>Senior Software Engineer, Filevine</h3>
            <p>
              Owned the Import service. Angular and Svelte front-end workflows, and
              mentorship on architecture and APIs.
            </p>
          </div>
        </li>
        <li class="job">
          <p class="when">Nov 2019 to Sep 2020</p>
          <div class="job-body">
            <h3>Senior Software Engineer, Young Living</h3>
            <p>
              Seven Kotlin/Kafka microservices for fulfillment, from design through
              production, with Splunk monitoring and offshore coordination.
            </p>
          </div>
        </li>
        <li class="job">
          <p class="when">May 2017 to Nov 2019</p>
          <div class="job-body">
            <h3>Senior Software Architect and Engineer, Alpine Testing Solutions</h3>
            <p>
              Legacy platform redesign, WCF services moved to GraphQL, and mentoring
              for remote engineers.
            </p>
          </div>
        </li>
        <li class="job">
          <p class="when">2013 to 2017</p>
          <div class="job-body">
            <h3>Earlier</h3>
            <p>
              .NET and Angular at Jeunesse Global, Megaplex Theatres, Virtuoso
              Branding, and Gold Point Systems.
            </p>
          </div>
        </li>
      </ol>
      <p class="education">BS, Computer Science, Weber State University.</p>
    </section>
    <section class="section" id="approach">
      <h2>How I work</h2>
      <ul class="approach">
        <li>
          Mentored junior engineers at Filevine on architecture and API development,
          and led Angular localization.
        </li>
        <li>
          Coordinated offshore development at Young Living while taking Kafka
          services from design through production.
        </li>
        <li>
          Mentored remote engineers at Alpine Testing Solutions and led design
          discussions during the platform redesign.
        </li>
      </ul>
    </section>
    <section class="section" id="contact">
      <h2>Contact</h2>
      <p>Email or LinkedIn is the best way to reach me.</p>
      <ul class="contact-list">
        <li><a href="mailto:andrew@andrewoakeson.com">andrew@andrewoakeson.com</a></li>
        <li>
          <a href="https://www.linkedin.com/in/andrew-oakeson/">linkedin.com/in/andrew-oakeson</a>
        </li>
        <li><a class="quiet" href="https://github.com/aoakeson">github.com/aoakeson</a></li>
      </ul>
    </section>
  </main>
  <footer class="site-footer wrap">
    <p>Andrew Oakeson</p>
  </footer>
</Base>

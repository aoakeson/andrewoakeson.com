{
  "name": "andrewoakeson",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "ASK_LIMIT",
      "id": "60e7c4ee1ded4ece856daa2a389fdc1f"
    }
  ],
  "routes": [
    { "pattern": "andrewoakeson.com", "custom_domain": true },
    { "pattern": "www.andrewoakeson.com", "custom_domain": true }
  ]
}
